{
  "expo": {
    "name": "JobReady Offline",
    "slug": "neltzsocial-jobready-offline",
    "version": "1.0.1",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/icon-offline.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neltzsocial.jobready.offline"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-offline.png",
        "backgroundColor": "#0B0F19"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": false,
      "package": "com.neltzsocial.jobready.offline"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset"
    ],
    "jsEngine": "jsc",
    "owner": "neltheprogrammer",
    "extra": {
      "eas": {
        "projectId": "c5c0dc5e-4622-4599-9ec3-76f6d70795e9"
      }
    }
  }
}
